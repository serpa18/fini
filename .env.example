PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PORT=8181
PLUGGY_ITEM_ID=
PLUGGY_ITEM_NAMES=
APP_USER_NAME=

# Backups automáticos em 2 ambientes (caminhos dentro do container)
BACKUP_DIR_LOCAL=/app/backups/local
BACKUP_DIR_CLOUD=/app/backups/gdrive
BACKUP_KEEP=15

# No ZimaOS, informe os caminhos reais montados no host (usados no docker-compose.yml):
# ZIMA_BACKUP_LOCAL=/DATA/AppData/fini/backups-local
# ZIMA_BACKUP_GDRIVE=/media/ZimaOS-HD/GoogleDrive/Backups/fini

